<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 240 240" width="240" height="240">
  <defs>
    <linearGradient id="grad_pain" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#DC2626" stop-opacity="0.18"/>
      <stop offset="100%" stop-color="#DC2626" stop-opacity="0.04"/>
    </linearGradient>
    <linearGradient id="border_pain" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#DC2626" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#DC2626" stop-opacity="0.3"/>
    </linearGradient>
  </defs>

  <rect x="6" y="6" width="228" height="228" rx="28" fill="#ffffff" stroke="url(#border_pain)" stroke-width="2"/>
  <rect x="12" y="12" width="216" height="216" rx="22" fill="url(#grad_pain)"/>

  <circle cx="120" cy="95" r="48" fill="#DC2626" fill-opacity="0.12" stroke="#DC2626" stroke-width="2" stroke-dasharray="4 4"/>

  <text x="120" y="112" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="44" text-anchor="middle" dominant-baseline="central">
    ⚡
  </text>

  <rect x="30" y="160" width="180" height="34" rx="10" fill="#DC2626" fill-opacity="0.12" stroke="#DC2626" stroke-width="1.2"/>
  <text x="120" y="182" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="15" font-weight="700" fill="#1e293b" text-anchor="middle">
